## Section 2: Production-Grade Code and Implementation

This implementation separates:

1. Immutable input history.
2. Rejected-record metadata.
3. Current dimensional state.
4. Current loan facts.
5. Batch identity.

It provides:

- SHA-256 batch identity.
- Atomic SQLite ingestion.
- Identical-duplicate handling.
- Fatal conflicting-version detection.
- Deterministic current-state selection.
- Exact integer sums.
- Redacted rejection logging.

The SQLite implementation is appropriate for the local lab and modest single-writer workloads. It is not positioned as a distributed warehouse.

```python name=loanbook/batch.py
import argparse
import hashlib
import json
import logging
import os
import sqlite3
import tempfile
from pathlib import Path

from loanbook.model import ValidationError, canonical_json, parse_record

LOG = logging.getLogger("loanbook.batch")

DDL = """
PRAGMA foreign_keys = ON;
PRAGMA journal_mode = WAL;

CREATE TABLE IF NOT EXISTS batches (
    batch_id TEXT PRIMARY KEY,
    input_rows INTEGER NOT NULL,
    valid_rows INTEGER NOT NULL,
    rejected_rows INTEGER NOT NULL,
    duplicate_rows INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS loan_events (
    loan_id TEXT NOT NULL,
    version INTEGER NOT NULL CHECK (version > 0),
    payload TEXT NOT NULL,
    PRIMARY KEY (loan_id, version)
);

CREATE TABLE IF NOT EXISTS rejected_records (
    batch_id TEXT NOT NULL,
    line_number INTEGER NOT NULL,
    reason TEXT NOT NULL,
    raw_sha256 TEXT NOT NULL,
    PRIMARY KEY (batch_id, line_number),
    FOREIGN KEY (batch_id) REFERENCES batches(batch_id)
);

CREATE TABLE IF NOT EXISTS dim_customer (
    customer_id TEXT PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS fact_loan (
    loan_id TEXT PRIMARY KEY,
    version INTEGER NOT NULL,
    customer_id TEXT NOT NULL,
    principal_cents INTEGER NOT NULL CHECK (principal_cents > 0),
    status TEXT NOT NULL CHECK (status IN ('CURRENT', 'LATE', 'PAID')),
    FOREIGN KEY (customer_id) REFERENCES dim_customer(customer_id)
);
"""


def connect(database: Path) -> sqlite3.Connection:
    database.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(
        database,
        timeout=30,
        isolation_level=None,
    )
    connection.execute("PRAGMA foreign_keys = ON")
    connection.execute("PRAGMA busy_timeout = 30000")
    return connection


def ingest(input_path: Path, database: Path) -> dict:
    connection = connect(database)
    try:
        connection.executescript(DDL)
        with input_path.open("rb") as source:
            batch_id = hashlib.file_digest(source, "sha256").hexdigest()
            source.seek(0)

            connection.execute("BEGIN IMMEDIATE")
            try:
                existing_batch = connection.execute(
                    "SELECT batch_id FROM batches WHERE batch_id = ?",
                    (batch_id,),
                ).fetchone()

                if existing_batch is not None:
                    connection.execute("COMMIT")
                    return {
                        "batch_id": batch_id,
                        "already_processed": True,
                    }

                connection.execute(
                    """
                    INSERT INTO batches
                    VALUES (?, 0, 0, 0, 0)
                    """,
                    (batch_id,),
                )

                counts = {
                    "input_rows": 0,
                    "valid_rows": 0,
                    "rejected_rows": 0,
                    "duplicate_rows": 0,
                }

                for line_number, raw in enumerate(source, start=1):
                    counts["input_rows"] += 1

                    try:
                        line = raw.decode("utf-8")
                        record = parse_record(line)
                    except (UnicodeDecodeError, ValidationError) as exc:
                        counts["rejected_rows"] += 1
                        reason = (
                            "invalid_utf8"
                            if isinstance(exc, UnicodeDecodeError)
                            else str(exc)
                        )
                        connection.execute(
                            """
                            INSERT INTO rejected_records
                            VALUES (?, ?, ?, ?)
                            """,
                            (
                                batch_id,
                                line_number,
                                reason,
                                hashlib.sha256(raw).hexdigest(),
                            ),
                        )
                        continue

                    counts["valid_rows"] += 1
                    payload = canonical_json(record)
                    key = (record["loan_id"], record["version"])

                    existing_event = connection.execute(
                        """
                        SELECT payload
                        FROM loan_events
                        WHERE loan_id = ? AND version = ?
                        """,
                        key,
                    ).fetchone()

                    if existing_event is not None:
                        if existing_event[0] != payload:
                            raise ValueError(
                                "CONFLICTING_VERSION: "
                                f"loan={key[0]} version={key[1]}"
                            )
                        counts["duplicate_rows"] += 1
                        continue

                    connection.execute(
                        """
                        INSERT INTO loan_events
                        (loan_id, version, payload)
                        VALUES (?, ?, ?)
                        """,
                        (key[0], key[1], payload),
                    )

                latest_events = connection.execute(
                    """
                    SELECT e.payload
                    FROM loan_events AS e
                    JOIN (
                        SELECT loan_id, MAX(version) AS version
                        FROM loan_events
                        GROUP BY loan_id
                    ) AS latest
                    ON e.loan_id = latest.loan_id
                    AND e.version = latest.version
                    """
                )

                for (payload,) in latest_events:
                    record = json.loads(payload)

                    connection.execute(
                        """
                        INSERT INTO dim_customer(customer_id)
                        VALUES (?)
                        ON CONFLICT(customer_id) DO NOTHING
                        """,
                        (record["customer_id"],),
                    )

                    connection.execute(
                        """
                        INSERT INTO fact_loan (
                            loan_id,
                            version,
                            customer_id,
                            principal_cents,
                            status
                        )
                        VALUES (?, ?, ?, ?, ?)
                        ON CONFLICT(loan_id) DO UPDATE SET
                            version = excluded.version,
                            customer_id = excluded.customer_id,
                            principal_cents = excluded.principal_cents,
                            status = excluded.status
                        """,
                        (
                            record["loan_id"],
                            record["version"],
                            record["customer_id"],
                            record["principal_cents"],
                            record["status"],
                        ),
                    )

                connection.execute(
                    """
                    UPDATE batches
                    SET input_rows = ?,
                        valid_rows = ?,
                        rejected_rows = ?,
                        duplicate_rows = ?
                    WHERE batch_id = ?
                    """,
                    (
                        counts["input_rows"],
                        counts["valid_rows"],
                        counts["rejected_rows"],
                        counts["duplicate_rows"],
                        batch_id,
                    ),
                )

                connection.execute("COMMIT")
                result = {
                    "batch_id": batch_id,
                    "already_processed": False,
                    **counts,
                }
                LOG.info("ingestion_complete %s", json.dumps(result))
                return result

            except BaseException:
                if connection.in_transaction:
                    connection.execute("ROLLBACK")
                raise
    finally:
        connection.close()


def atomic_write_lines(path: Path, lines) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=path.parent,
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            for line in lines:
                handle.write(line + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)


def export_snapshot(database: Path, output: Path) -> dict:
    connection = connect(database)
    try:
        connection.execute("BEGIN")

        columns = [
            "loan_id",
            "version",
            "customer_id",
            "principal_cents",
            "status",
        ]

        def json_lines():
            cursor = connection.execute(
                """
                SELECT loan_id, version, customer_id, principal_cents, status
                FROM fact_loan
                ORDER BY loan_id
                """
            )
            for row in cursor:
                yield canonical_json(dict(zip(columns, row)))

        atomic_write_lines(output / "current.jsonl", json_lines())

        def tsv_lines():
            cursor = connection.execute(
                """
                SELECT loan_id, customer_id, principal_cents, status, version
                FROM fact_loan
                ORDER BY loan_id
                """
            )
            for row in cursor:
                yield "\t".join(str(value) for value in row)

        atomic_write_lines(output / "current.tsv", tsv_lines())

        row = connection.execute(
            """
            SELECT
                COUNT(*),
                COALESCE(SUM(principal_cents), 0),
                COALESCE(SUM(
                    CASE WHEN status IN ('CURRENT', 'LATE')
                    THEN principal_cents ELSE 0 END
                ), 0),
                COALESCE(SUM(
                    CASE WHEN status = 'LATE'
                    THEN principal_cents ELSE 0 END
                ), 0)
            FROM fact_loan
            """
        ).fetchone()

        metrics = dict(
            zip(
                [
                    "loan_count",
                    "principal_cents",
                    "active_principal_cents",
                    "delinquent_principal_cents",
                ],
                row,
            )
        )

        connection.execute("COMMIT")
        return metrics
    except BaseException:
        if connection.in_transaction:
            connection.execute("ROLLBACK")
        raise
    finally:
        connection.close()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", type=Path, required=True)
    parser.add_argument("--database", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s %(message)s",
    )

    try:
        result = ingest(args.input, args.database)
        metrics = export_snapshot(args.database, args.output)
        print(json.dumps({"ingestion": result, "metrics": metrics}, indent=2))
    except Exception:
        LOG.exception("batch_failed")
        raise


if __name__ == "__main__":
    main()
```

### Transaction and publication boundaries

The database ingestion is one transaction.

The two exported files are **individually replaced atomically on a suitable local filesystem**, but they are not published as a single atomic multi-file snapshot.

A production multi-file publication design should use:

1. An immutable run directory.
2. Complete data-file writes.
3. Reconciliation.
4. A commit manifest.
5. Readers that only consume committed runs.

The Week 4 implementation demonstrates the manifest approach.

Also, the batch hash assumes an immutable source file during the hash-and-read operation. Production ingestion should land files immutably before processing.

