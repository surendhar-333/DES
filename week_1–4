## Section 2: Production-Grade Code and Implementation

The MapReduce job sums principal by loan status from the validated TSV snapshot.

It uses:

- Strict field validation.
- Exact signed 64-bit values.
- Overflow detection.
- A valid sum combiner.
- Explicit memory settings.
- Bounded retries.
- Fail-fast behavior for invalid Silver data.

```java name=java/LoanTotals.java
import java.io.IOException;
import java.util.Set;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.conf.Configured;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.io.LongWritable;
import org.apache.hadoop.io.Text;
import org.apache.hadoop.mapreduce.Job;
import org.apache.hadoop.mapreduce.Mapper;
import org.apache.hadoop.mapreduce.Reducer;
import org.apache.hadoop.mapreduce.lib.input.FileInputFormat;
import org.apache.hadoop.mapreduce.lib.output.FileOutputFormat;
import org.apache.hadoop.util.Tool;
import org.apache.hadoop.util.ToolRunner;

public final class LoanTotals extends Configured implements Tool {
    private static final Set<String> STATUSES =
        Set.of("CURRENT", "LATE", "PAID");

    public enum Counters {
        VALID_INPUT_ROWS,
        INVALID_INPUT_ROWS
    }

    public static final class LoanMapper
            extends Mapper<LongWritable, Text, Text, LongWritable> {

        private final Text outputKey = new Text();
        private final LongWritable outputValue = new LongWritable();

        @Override
        protected void map(
                LongWritable offset,
                Text line,
                Context context
        ) throws IOException, InterruptedException {
            String[] fields = line.toString().split("\\t", -1);

            if (fields.length != 5) {
                context.getCounter(Counters.INVALID_INPUT_ROWS).increment(1);
                throw new IOException(
                    "Expected 5 TSV fields at byte offset " + offset.get()
                );
            }

            long principal;
            long version;

            try {
                principal = Long.parseLong(fields[2]);
                version = Long.parseLong(fields[4]);
            } catch (NumberFormatException exception) {
                context.getCounter(Counters.INVALID_INPUT_ROWS).increment(1);
                throw new IOException(
                    "Invalid numeric field at byte offset " + offset.get(),
                    exception
                );
            }

            if (fields[0].isEmpty()
                    || fields[1].isEmpty()
                    || principal <= 0
                    || principal > 1_000_000_000_000L
                    || version <= 0
                    || !STATUSES.contains(fields[3])) {
                context.getCounter(Counters.INVALID_INPUT_ROWS).increment(1);
                throw new IOException(
                    "Input contract violation at byte offset " + offset.get()
                );
            }

            outputKey.set(fields[3]);
            outputValue.set(principal);

            context.write(outputKey, outputValue);
            context.getCounter(Counters.VALID_INPUT_ROWS).increment(1);
        }
    }

    public static final class SumReducer
            extends Reducer<Text, LongWritable, Text, LongWritable> {

        private final LongWritable outputValue = new LongWritable();

        @Override
        protected void reduce(
                Text key,
                Iterable<LongWritable> values,
                Context context
        ) throws IOException, InterruptedException {
            long total = 0L;

            for (LongWritable value : values) {
                try {
                    total = Math.addExact(total, value.get());
                } catch (ArithmeticException exception) {
                    throw new IOException(
                        "Signed 64-bit overflow for status " + key,
                        exception
                    );
                }
            }

            outputValue.set(total);
            context.write(key, outputValue);
        }
    }

    @Override
    public int run(String[] args) throws Exception {
        if (args.length != 2) {
            System.err.println(
                "Usage: LoanTotals <input-path> <new-output-directory>"
            );
            return 2;
        }

        Configuration configuration = getConf();
        configuration.setInt("mapreduce.map.maxattempts", 2);
        configuration.setInt("mapreduce.reduce.maxattempts", 2);
        configuration.setBoolean("mapreduce.map.speculative", false);
        configuration.setBoolean("mapreduce.reduce.speculative", false);

        Job job = Job.getInstance(configuration, "loan-principal-by-status");
        job.setJarByClass(LoanTotals.class);

        job.setMapperClass(LoanMapper.class);
        job.setCombinerClass(SumReducer.class);
        job.setReducerClass(SumReducer.class);

        job.setMapOutputKeyClass(Text.class);
        job.setMapOutputValueClass(LongWritable.class);
        job.setOutputKeyClass(Text.class);
        job.setOutputValueClass(LongWritable.class);

        job.setNumReduceTasks(2);

        FileInputFormat.addInputPath(job, new Path(args[0]));
        FileOutputFormat.setOutputPath(job, new Path(args[1]));

        return job.waitForCompletion(true) ? 0 : 1;
    }

    public static void main(String[] args) throws Exception {
        int status = ToolRunner.run(
            new Configuration(),
            new LoanTotals(),
            args
        );
        System.exit(status);
    }
}
```

