## 1.6 Shared contract enforcement

A subtle Python issue: `bool` is a subclass of `int`. Consequently, `isinstance(True, int)` is true. Financial validation should not accept `true` as one cent.

```python name=loanbook/model.py
import json
import re
from typing import Any

FIELDS = {
    "loan_id",
    "version",
    "customer_id",
    "principal_cents",
    "status",
}
STATUSES = {"CURRENT", "LATE", "PAID"}
IDENTIFIER = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
MAX_PRINCIPAL_CENTS = 10**12


class ValidationError(ValueError):
    """A record violates the input contract."""


def validate_record(value: Any) -> dict:
    if not isinstance(value, dict):
        raise ValidationError("record_must_be_an_object")

    if set(value) != FIELDS:
        raise ValidationError("unexpected_or_missing_fields")

    for field in ("loan_id", "customer_id"):
        identifier = value[field]
        if not isinstance(identifier, str):
            raise ValidationError(f"{field}_must_be_a_string")
        if not IDENTIFIER.fullmatch(identifier):
            raise ValidationError(f"{field}_has_invalid_format")

    if type(value["version"]) is not int or value["version"] <= 0:
        raise ValidationError("version_must_be_a_positive_integer")

    principal = value["principal_cents"]
    if type(principal) is not int:
        raise ValidationError("principal_must_be_integer_cents")
    if not 0 < principal <= MAX_PRINCIPAL_CENTS:
        raise ValidationError("principal_out_of_range")

    if not isinstance(value["status"], str):
        raise ValidationError("status_must_be_a_string")
    if value["status"] not in STATUSES:
        raise ValidationError("unsupported_status")

    return {key: value[key] for key in sorted(FIELDS)}


def parse_record(line: str) -> dict:
    try:
        value = json.loads(line)
    except json.JSONDecodeError as exc:
        raise ValidationError("malformed_json") from exc
    return validate_record(value)


def canonical_json(record: dict) -> str:
    return json.dumps(record, sort_keys=True, separators=(",", ":"))
```

