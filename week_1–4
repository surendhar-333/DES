### 5.10 Design

The pipeline follows this sequence:

1. Read one text record per input line.
2. Validate each JSON record using the existing source contract.
3. Separate valid and rejected records.
4. Remove identical duplicates across the entire payload.
5. Detect conflicting payloads for a loan version.
6. Select the highest version per loan.
7. Calculate exact principal totals.
8. Write separate Parquet outputs.

Rejected output contains:

- Source file.
- SHA-256 fingerprint of the decoded line.
- Rejection reason.

It deliberately excludes the raw financial payload.

A hash is useful for correlation, but it is **not a guarantee of anonymization**. Treat rejection metadata as access-controlled data.

### 5.11 Implementation

```python name=loanbook/dataframe_job.py
import argparse
import hashlib
import json
from decimal import Decimal

from pyspark import StorageLevel
from pyspark.sql import DataFrame, SparkSession, Window
from pyspark.sql import functions as F
from pyspark.sql import types as T

from loanbook.model import ValidationError, parse_record


LONG_MAX = 2**63 - 1

BUSINESS_COLUMNS = [
    "loan_id",
    "version",
    "customer_id",
    "principal_cents",
    "status",
]

PARSED_SCHEMA = T.StructType([
    T.StructField("source_file", T.StringType(), False),
    T.StructField("raw_sha256", T.StringType(), False),
    T.StructField("reject_reason", T.StringType(), True),
    T.StructField("loan_id", T.StringType(), True),
    T.StructField("version", T.LongType(), True),
    T.StructField("customer_id", T.StringType(), True),
    T.StructField("principal_cents", T.LongType(), True),
    T.StructField("status", T.StringType(), True),
])


def parse_partition(rows):
    """Validate records once per iterator; preserve no raw payload in output."""
    for row in rows:
        raw = row["raw"]
        source_file = row["source_file"]

        # Fingerprint of decoded UTF-8 text, excluding the line terminator.
        # This is not an exact fingerprint of the original file bytes.
        fingerprint = hashlib.sha256(raw.encode("utf-8")).hexdigest()

        try:
            record = parse_record(raw)

            if record["version"] > LONG_MAX:
                raise ValidationError("version_exceeds_spark_long")

        except ValidationError as exc:
            yield (
                source_file,
                fingerprint,
                str(exc),
                None,
                None,
                None,
                None,
                None,
            )
        else:
            yield (
                source_file,
                fingerprint,
                None,
                record["loan_id"],
                record["version"],
                record["customer_id"],
                record["principal_cents"],
                record["status"],
            )


def parse_lines(raw: DataFrame) -> DataFrame:
    return raw.sparkSession.createDataFrame(
        raw.rdd.mapPartitions(parse_partition),
        PARSED_SCHEMA,
    )


def read_input(spark: SparkSession, path: str) -> DataFrame:
    raw = spark.read.text(path).select(
        F.col("value").alias("raw"),
        F.input_file_name().alias("source_file"),
    )
    return parse_lines(raw)


def valid_records(parsed: DataFrame) -> DataFrame:
    return (
        parsed
        .filter(F.col("reject_reason").isNull())
        .select(*BUSINESS_COLUMNS)
    )


def rejected_records(parsed: DataFrame) -> DataFrame:
    return (
        parsed
        .filter(F.col("reject_reason").isNotNull())
        .select("source_file", "raw_sha256", "reject_reason")
    )


def assert_no_conflicts(unique_versions: DataFrame) -> None:
    conflicts = (
        unique_versions
        .groupBy("loan_id", "version")
        .count()
        .filter(F.col("count") > 1)
    )

    # Bring back only an existence signal, not sensitive payloads.
    if conflicts.limit(1).count() > 0:
        raise ValueError("CONFLICTING_VERSION")


def current_snapshot(unique_versions: DataFrame) -> DataFrame:
    ordering = (
        Window
        .partitionBy("loan_id")
        .orderBy(F.col("version").desc())
    )

    return (
        unique_versions
        .withColumn("_row_number", F.row_number().over(ordering))
        .filter(F.col("_row_number") == 1)
        .drop("_row_number")
    )


def portfolio_metrics(current: DataFrame) -> DataFrame:
    # Cast BEFORE summing. Casting a potentially overflowing long sum
    # afterward would be too late.
    amount = F.col("principal_cents").cast("decimal(38,0)")
    zero = F.lit(0).cast("decimal(38,0)")

    totals = current.agg(
        F.count("*").alias("loan_count"),
        F.coalesce(F.sum(amount), zero).alias("principal_cents"),
        F.coalesce(
            F.sum(
                F.when(
                    F.col("status").isin("CURRENT", "LATE"),
                    amount,
                ).otherwise(zero)
            ),
            zero,
        ).alias("active_principal_cents"),
        F.coalesce(
            F.sum(
                F.when(F.col("status") == "LATE", amount)
                .otherwise(zero)
            ),
            zero,
        ).alias("delinquent_principal_cents"),
    )

    return totals.withColumn(
        "delinquency_ratio",
        F.when(
            F.col("active_principal_cents") != zero,
            F.col("delinquent_principal_cents")
            / F.col("active_principal_cents"),
        ).otherwise(F.lit(None).cast("decimal(38,6)")),
    )


def run(spark: SparkSession, input_path: str, output_path: str) -> dict:
    cached = []

    def remember(frame: DataFrame) -> DataFrame:
        result = frame.persist(StorageLevel.MEMORY_AND_DISK_DESER)
        cached.append(result)
        return result

    try:
        parsed = remember(read_input(spark, input_path))

        input_count = parsed.count()
        valid = valid_records(parsed)
        rejected = rejected_records(parsed)

        valid_count = valid.count()
        rejected_count = rejected.count()

        assert input_count == valid_count + rejected_count

        # Remove identical complete payloads, not arbitrary rows per key.
        unique_versions = remember(valid.distinct())
        unique_count = unique_versions.count()

        # Must happen before selecting the latest version.
        assert_no_conflicts(unique_versions)

        current = remember(current_snapshot(unique_versions))
        current_count = current.count()

        metrics = portfolio_metrics(current)
        metric_row = metrics.first().asDict()

        audit = {
            "input_rows": input_count,
            "valid_rows": valid_count,
            "rejected_rows": rejected_count,
            "duplicate_rows": valid_count - unique_count,
            "unique_versions": unique_count,
            "superseded_versions": unique_count - current_count,
            "current_loans": current_count,
        }

        base = output_path.rstrip("/")

        # Use a fresh output path per run. These writes are NOT one transaction.
        rejected.write.mode("errorifexists").parquet(f"{base}/rejected")
        current.write.mode("errorifexists").parquet(f"{base}/current")
        metrics.write.mode("errorifexists").parquet(f"{base}/metrics")

        return {"audit": audit, "metrics": metric_row}

    finally:
        for frame in reversed(cached):
            frame.unpersist(blocking=True)


def json_default(value):
    if isinstance(value, Decimal):
        return str(value)
    raise TypeError(f"Unsupported JSON type: {type(value).__name__}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", required=True)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()

    spark = (
        SparkSession.builder
        .appName("loanbook-dataframes")
        .config("spark.sql.ansi.enabled", "true")
        .config("spark.sql.session.timeZone", "UTC")
        .getOrCreate()
    )

    try:
        result = run(spark, args.input, args.output)
        print(json.dumps(result, indent=2, default=json_default))
    finally:
        spark.stop()


if __name__ == "__main__":
    main()
```

